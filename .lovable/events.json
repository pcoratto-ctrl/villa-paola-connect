{
  "schema_version": 1,
  "events": {
    "project.availability_cta_clicked": {
      "event_schema_version": 1,
      "description": "An existing availability or quote anchor is clicked after measurement opt-in; not an enquiry or booking.",
      "privacy": {
        "contains_pii": false,
        "purpose": "product_analytics"
      },
      "properties_schema": {
        "additionalProperties": false,
        "properties": {
          "landing_path": {
            "type": "string"
          },
          "page_language": {
            "enum": [
              "it",
              "en"
            ],
            "type": "string"
          },
          "referrer_host": {
            "type": "string"
          },
          "utm_campaign": {
            "enum": [
              "villa_paola",
              "villa-paola",
              "spring",
              "autumn",
              "summer"
            ],
            "type": "string"
          },
          "utm_medium": {
            "enum": [
              "social",
              "organic",
              "referral",
              "email",
              "cpc",
              "paid_social"
            ],
            "type": "string"
          },
          "utm_source": {
            "enum": [
              "facebook",
              "instagram",
              "google",
              "bing",
              "newsletter"
            ],
            "type": "string"
          }
        },
        "required": [
          "page_language"
        ],
        "type": "object"
      }
    },
